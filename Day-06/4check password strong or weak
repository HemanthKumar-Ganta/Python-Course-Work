n = input("Enter a password:")

if len(n) < 8:
    print("Weak password")
elif not any(i.isupper() for i in n):
    print("Weak password")
elif not any(i.islower() for i in n):
    print("Weak password")
elif not any(i.isdigit() for i in n):
    print("Weak password")
elif not any(not i.isalnum() for i in n):
    print("Weak password")
else:
    print("Strong password")