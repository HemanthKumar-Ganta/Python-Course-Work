weight = float(input("enter the weight:"))
height = float(input("enter the height:"))
height1 = height / 100
BMI = weight /( height1 * height1)
print(BMI)
if BMI <= 18.5:
    print("under_weight")
elif 18.5 < BMI <= 24.9:
    print("normal_weight")
elif 24.9 < BMI <= 29.9:
    print("over_weight")
else:
    print("obese")