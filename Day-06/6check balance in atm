balance = 1000
choice = input("enter 1 to check balance or enter 2 to withdraw money:")
if choice == "1":
    print("current_balane:" , balance)
elif choice == "2":
    amount = int(input("enter amount:"))
    if amount < 100:
        print("minimum withdrawal amount is 100")
    elif amount % 100 != 0:
        print("enter amount only in hundreds")
    elif amount > balance:
        print("insufficient balance")
    else:
        remaining_balance = balance - amount
        print("withdrawal_amount successful")
        print(remaining_balance)
else:
    print("invalid choice")